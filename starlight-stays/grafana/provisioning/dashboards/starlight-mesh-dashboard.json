      "id": 2,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_requests_seconds_bucket[1m])))",
          "legendFormat": "p95 - {{job}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, job) (rate(http_server_requests_seconds_bucket[1m])))",
          "legendFormat": "p99 - {{job}}",
          "refId": "B"
        }
      ],
      "title": "Latency Percentiles (p95 / p99)",
      "type": "timeseries"
    },
