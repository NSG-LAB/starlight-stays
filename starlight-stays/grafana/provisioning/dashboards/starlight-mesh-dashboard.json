      },
      "targets": [
        {
          "expr": "sum by (job, status) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{job}} ({{status}})",
          "refId": "A"
        }
      ],
      "title": "Throughput by Service & Status (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "unit": "s"
        },
        "overrides": []
      },
